{
  "manifest_version": 3,
  "name": "Carbofile",
  "version": "0.1.0",
  "description": "Agente de IA que limpia archivos innecesarios de tus descargas y tu nube para reducir tu huella digital.",
  "permissions": ["downloads", "storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Carbofile" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
